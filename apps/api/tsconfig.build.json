{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node"],
        "declaration": false,
        "declarationMap": false,
        "sourceMap": true,
        "noEmit": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/test/**"]
}
