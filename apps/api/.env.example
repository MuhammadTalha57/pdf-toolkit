NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://pdf:pdf@localhost:5432/pdf_toolkit

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=false

# Object storage (leave S3_ENDPOINT/keys empty on AWS; set them for local MinIO)
S3_BUCKET=pdf-toolkit-files
AWS_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CORS (the web origin; same-origin in production via the web proxy)
FRONTEND_ORIGIN=http://localhost:3000

MAX_UPLOAD_MB=10
