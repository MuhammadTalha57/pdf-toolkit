# Copy to terraform.tfvars (git-ignored) and edit if needed.
# Every value below is optional; these are the defaults.

aws_region        = "us-east-1"
project           = "pdf-toolkit"
environment       = "prod"
github_repository = "MuhammadTalha57/pdf-toolkit" # change to your fork

# Horizontal scaling per service (web and api). Raise max_tasks to allow more.
min_tasks          = 1
max_tasks          = 2
cpu_target_percent = 60

# Restrict who can open the app, e.g. ["203.0.113.7/32"].
allowed_http_cidrs = ["0.0.0.0/0"]

db_instance_class = "db.t4g.micro"
db_multi_az       = false
